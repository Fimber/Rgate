# Copy to .env for local development:  copy .env.example .env   (Windows)  /  cp .env.example .env
DEBUG=true
# Production refuses to start with this placeholder. Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-before-pilot
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PLATFORM_DOMAIN=localhost:8000
SMS_PROVIDER=console
SMS_SENDER_ID=ReGate
LOG_LEVEL=INFO

# --- Production -------------------------------------------------------------
# DEBUG=false
# ALLOWED_HOSTS=regate.ng,.regate.ng
# CSRF_TRUSTED_ORIGINS=https://regate.ng,https://*.regate.ng
# PLATFORM_DOMAIN=regate.ng
# Behind nginx / a load balancer that terminates TLS:
# BEHIND_TLS_PROXY=true
# TRUST_X_FORWARDED_FOR=true      # only if the proxy overwrites the header
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_PRELOAD=false       # opt in only once every subdomain is HTTPS

# PostgreSQL
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=regate
# DB_USER=regate
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
